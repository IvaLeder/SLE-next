// Post-build step for Cloudflare: turns Next's compiled routing into what the
// Worker and Cloudflare's static asset server need.
//
//   .next/routes-manifest.json  (written by `next build`, even with output: export)
//     → worker/generated/routes.json  redirects + headers, used by worker/index.ts
//     → out/_headers                   headers() rules for files served directly
//
// The manifest holds the exact regexes Vercel routed by (same order, same
// case-insensitivity), so replaying them in the Worker keeps every redirect
// identical, including the WordPress image-size patterns that Cloudflare's
// own _redirects syntax can't express.
//
// Run after `next build`: node scripts/cloudflare/build-routing.mts

import fs from "node:fs";
import path from "node:path";
import { createRequire } from "node:module";

const require = createRequire(import.meta.url);
const { pathToRegexp } = require("next/dist/compiled/path-to-regexp") as {
  pathToRegexp: (path: string, keys: { name: string | number }[], options: object) => RegExp;
};

const root = process.cwd();
const outDir = path.join(root, "out");
const manifest = JSON.parse(fs.readFileSync(path.join(root, ".next/routes-manifest.json"), "utf8")) as {
  caseSensitive: boolean;
  redirects: { source: string; destination: string; statusCode?: number; permanent?: boolean; regex: string; internal?: boolean }[];
  headers: { source: string; headers: { key: string; value: string }[]; regex: string }[];
};

const flags = manifest.caseSensitive ? "" : "i";

/** Param names in capture-group order, as path-to-regexp numbers them. */
function keysOf(source: string): string[] {
  const keys: { name: string | number }[] = [];
  pathToRegexp(source, keys, { delimiter: "/", sensitive: manifest.caseSensitive, strict: true });
  return keys.map((k) => String(k.name));
}

function groupCount(regex: string): number {
  return new RegExp(`${regex}|`).exec("")!.length - 1;
}

const redirects = manifest.redirects.map((r) => {
  const keys = keysOf(r.source);
  if (groupCount(r.regex) !== keys.length) {
    throw new Error(`Redirect ${r.source}: ${groupCount(r.regex)} groups but ${keys.length} params`);
  }
  if (/[?#]|^https?:/.test(r.destination)) {
    throw new Error(`Redirect ${r.source}: destination ${r.destination} needs query/host support in the Worker`);
  }
  return {
    regex: r.regex,
    keys,
    destination: r.destination,
    status: r.statusCode ?? (r.permanent ? 308 : 307),
  };
});

const headerRules = manifest.headers.map((h) => ({
  source: h.source,
  regex: h.regex,
  headers: h.headers,
}));

fs.mkdirSync(path.join(root, "worker/generated"), { recursive: true });
fs.writeFileSync(
  path.join(root, "worker/generated/routes.json"),
  JSON.stringify({ flags, redirects, headers: headerRules }),
);

// ─── Files that a redirect source also matches ──────────────────────────────
// On Vercel, redirects win over files. Cloudflare serves a matching file before
// the Worker ever runs, so any overlap would silently change behaviour.
function walk(dir: string, base = ""): string[] {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
    const rel = `${base}/${e.name}`;
    return e.isDirectory() ? walk(path.join(dir, e.name), rel) : [rel];
  });
}
const files = walk(outDir);
const urlPaths = new Set<string>();
for (const f of files) {
  urlPaths.add(f);
  if (f.endsWith(".html")) urlPaths.add(f.slice(0, -5) || "/");
}
const compiled = redirects
  .filter((r) => !manifest.redirects.find((m) => m.regex === r.regex)?.internal)
  .map((r) => ({ ...r, re: new RegExp(r.regex, flags) }));
const shadowed = [...urlPaths].filter((p) => compiled.some((r) => r.re.test(p)));
if (shadowed.length > 0) {
  throw new Error(`These files would hide a redirect on Cloudflare:\n  ${shadowed.join("\n  ")}`);
}

// ─── out/_headers ───────────────────────────────────────────────────────────
// Cloudflare patterns only know `*` (any characters) and whole-segment
// `:placeholders`, so translate the simple shapes and enumerate the rest.
const MAX_RULES = 100; // Cloudflare's limit per _headers file

function toCloudflarePatterns(rule: (typeof headerRules)[number]): string[] {
  if (rule.source === "/(.*)") return ["/*"];
  // Leading alternation like /(en|hr)/… → one pattern per option.
  const alt = rule.source.match(/^\/\(([a-z|]+)\)(\/.*)$/);
  const sources = alt ? alt[1].split("|").map((a) => `/${a}${alt[2]}`) : [rule.source];
  const simple = sources.map((s) => s.replace(/\/:[a-z]+\*$/i, "/*"));
  if (simple.every((s) => !/[:()]/.test(s))) return simple;
  // Anything else: list the files the rule matches.
  const re = new RegExp(rule.regex, flags);
  return [...urlPaths].filter((p) => re.test(p)).sort();
}

const lines: string[] = [
  "# Generated by scripts/cloudflare/build-routing.mts from next.config.ts headers().",
  "# Do not edit: change next.config.ts and rebuild.",
  "",
];
let ruleCount = 0;
const addRule = (pattern: string, headers: { key: string; value: string }[]) => {
  ruleCount += 1;
  // "! Name" detaches a header set by a broader rule; it takes no value.
  lines.push(pattern, ...headers.map((h) => (h.key.startsWith("!") ? `  ${h.key}` : `  ${h.key}: ${h.value}`)), "");
};

for (const rule of headerRules) {
  for (const pattern of toCloudflarePatterns(rule)) addRule(pattern, rule.headers);
}

// Vercel's defaults that Cloudflare doesn't apply on its own.
// Hashed build assets never change, so browsers may cache them for a year.
addRule("/_next/static/*", [{ key: "Cache-Control", value: "public,max-age=31536000,immutable" }]);

// Generated images (opengraph-image, icon, apple-icon) are written without a
// file extension, so Cloudflare can't guess their type. They are all PNGs.
const GENERATED_IMAGE = /\/(opengraph-image|twitter-image|icon|apple-icon)-[a-z0-9]+$/;
const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
for (const f of files.filter((f) => GENERATED_IMAGE.test(f))) {
  if (!fs.readFileSync(path.join(outDir, f)).subarray(0, 8).equals(PNG_SIGNATURE)) {
    throw new Error(`${f} is not a PNG; teach build-routing.mts its content type`);
  }
}
// Cloudflare allows one `*` per rule, so match the folders with whole-segment
// placeholders: one rule per folder depth (/x/opengraph-image-*,
// /x/y/opengraph-image-*, …).
const imagePatterns = new Set(
  files
    .filter((f) => GENERATED_IMAGE.test(f))
    .map((f) => {
      const parts = f.split("/").slice(1);
      const name = parts.pop()!.replace(/-[a-z0-9]+$/, "-*");
      return "/" + [...parts.map((_, i) => `:p${i}`), name].join("/");
    }),
);
for (const pattern of [...imagePatterns].sort()) {
  addRule(pattern, [{ key: "Content-Type", value: "image/png" }]);
}
// Static share images (e.g. opengraph-image.jpg) also match those patterns.
// A more specific rule detaches the PNG type and sets the real one; repeating
// a header without `!` would join both values with a comma.
const TYPES: Record<string, string> = { jpg: "image/jpeg", jpeg: "image/jpeg", png: "image/png", gif: "image/gif", webp: "image/webp" };
const patternRes = [...imagePatterns].map(
  (p) => new RegExp(`^${p.replace(/:p\d+/g, "[^/]+").replace(/\*/g, ".*")}$`),
);
for (const f of files) {
  const ext = f.match(/\.([a-z]+)$/)?.[1];
  if (!ext || ext === "txt" || !patternRes.some((re) => re.test(f))) continue;
  if (!TYPES[ext]) throw new Error(`${f}: add its content type to build-routing.mts`);
  addRule(f, [
    { key: "! Content-Type", value: "" },
    { key: "Content-Type", value: TYPES[ext] },
  ]);
}

// Vercel sends the manifest with an explicit charset.
addRule("/manifest.webmanifest", [{ key: "Content-Type", value: "application/manifest+json; charset=utf-8" }]);

if (ruleCount > MAX_RULES) {
  throw new Error(`_headers has ${ruleCount} rules; Cloudflare allows ${MAX_RULES}`);
}
fs.writeFileSync(path.join(outDir, "_headers"), lines.join("\n"));

// ─── out/_redirects: /page/ → /page as a permanent 308 ──────────────────────
// Cloudflare's own trailing-slash redirect is a 307 (temporary); Vercel's is
// a 308. Listing every page keeps it permanent. URLs with no page behind
// them still reach the Worker, whose first rule does the same strip.
const MAX_STATIC_REDIRECTS = 2000; // Cloudflare's limit per _redirects file
const pages = files
  .filter((f) => f.endsWith(".html"))
  .map((f) => f.slice(0, -".html".length))
  .filter((p) => p !== "/404" && p !== "/_not-found" && !/\/404$/.test(p))
  // Drafts always run the Worker (run_worker_first), and their paths hold the
  // preview tokens, which must not be listed anywhere.
  .filter((p) => !/^\/(en|hr)\/draft\//.test(p))
  .sort();
if (pages.length > MAX_STATIC_REDIRECTS) {
  throw new Error(`${pages.length} trailing-slash redirects; Cloudflare allows ${MAX_STATIC_REDIRECTS}`);
}
fs.writeFileSync(
  path.join(outDir, "_redirects"),
  [
    "# Generated by scripts/cloudflare/build-routing.mts: /page/ → /page (308, like Vercel).",
    ...pages.map((p) => `${p}/ ${p} 308`),
    "",
  ].join("\n"),
);

console.log(
  `routing: ${redirects.length} redirects + ${headerRules.length} header rules → worker/generated/routes.json; ` +
    `${ruleCount} rules → out/_headers; ${pages.length} trailing-slash rules → out/_redirects`,
);
